{
  "version": 1,
  "rule": "Значение без подтверждённого источника оставляют как «не указано» или в разделе «Требует проверки».",
  "templates": {
    "Служебная_записка.docx": {"required": ["recipient", "sender", "date", "subject", "summary", "requested_action"], "repeatable": ["facts", "options"], "review": "requires_review"},
    "Коммерческое_предложение.docx": {"required": ["document_number", "date", "recipient", "items", "terms"], "repeatable": ["items"], "review": "requires_review"},
    "Договор_услуги.docx": {"required": ["number", "date", "customer", "provider", "services", "price_and_vat", "payment_and_acceptance"], "repeatable": [], "review": "requires_review"},
    "Протокол_совещания.docx": {"required": ["topic", "date_time_format", "participants", "agenda", "decisions"], "repeatable": ["discussion", "decisions"], "review": "requires_review"},
    "Письмо_претензия.docx": {"required": ["date", "recipient", "contract", "claim_summary", "demand"], "repeatable": ["facts"], "review": "requires_review"},
    "Отчёт_статус_проекта.docx": {"required": ["project", "period", "status", "status_reason"], "repeatable": ["plan_fact", "risks"], "review": "requires_review"}
  }
}
